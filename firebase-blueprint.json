{
  "entities": {
    "Photo": {
      "title": "Photo",
      "description": "Product showcase photo with metadata and cloud image URL stored in Firestore",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the photo"
        },
        "imageUrl": {
          "type": "string",
          "description": "Permanent cloud image URL or central image data",
          "maxLength": 1048576
        },
        "storagePath": {
          "type": "string",
          "description": "Path or identifier in cloud storage",
          "maxLength": 1024
        },
        "category": {
          "type": "string",
          "description": "Category of the product",
          "enum": ["windows", "doors", "balconies"]
        },
        "title": {
          "type": "string",
          "description": "Title or description of the product photo",
          "maxLength": 500
        },
        "order": {
          "type": "number",
          "description": "Display order index"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp in ISO format",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp",
          "maxLength": 64
        }
      },
      "required": ["imageUrl", "storagePath", "category"]
    },
    "PhotoData": {
      "title": "PhotoData",
      "description": "High resolution permanent image data payload in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "data": { "type": "string", "maxLength": 1048576 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["data"]
    },
    "PublishingSettings": {
      "title": "PublishingSettings",
      "description": "Global website photo publishing and visibility settings",
      "type": "object",
      "properties": {
        "isGalleryPublished": { "type": "boolean" },
        "publishWindows": { "type": "boolean" },
        "publishDoors": { "type": "boolean" },
        "publishBalconies": { "type": "boolean" },
        "unpublishedPhotoIds": { "type": "array" },
        "allowLightboxViewing": { "type": "boolean" },
        "watermarkOrBadgeVisible": { "type": "boolean" },
        "noticeMessage": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      }
    }
  },
  "firestore": {
    "/photos/{photoId}": {
      "schema": "Photo",
      "description": "Collection of UPVC product showcase photos"
    },
    "/photos_data/{photoId}": {
      "schema": "PhotoData",
      "description": "Collection of cloud image data payloads"
    },
    "/settings/{settingId}": {
      "schema": "PublishingSettings",
      "description": "Site-wide configuration and photo publishing rules"
    }
  }
}
