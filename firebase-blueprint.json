{
  "entities": {
    "Photo": {
      "title": "Photo",
      "description": "Product showcase photo with metadata and cloud image URL stored in Firestore",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the photo"
        },
        "imageUrl": {
          "type": "string",
          "description": "Permanent cloud image URL or central image data",
          "maxLength": 1048576
        },
        "storagePath": {
          "type": "string",
          "description": "Path or identifier in cloud storage",
          "maxLength": 1024
        },
        "category": {
          "type": "string",
          "description": "Category of the product",
          "enum": ["windows", "doors", "balconies"]
        },
        "title": {
          "type": "string",
          "description": "Title or description of the product photo",
          "maxLength": 500
        },
        "order": {
          "type": "number",
          "description": "Display order index"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp in ISO format",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp",
          "maxLength": 64
        }
      },
      "required": ["imageUrl", "storagePath", "category"]
    },
    "PhotoData": {
      "title": "PhotoData",
      "description": "High resolution permanent image data payload in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "data": { "type": "string", "maxLength": 1048576 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["data"]
    }
  },
  "firestore": {
    "/photos/{photoId}": {
      "schema": "Photo",
      "description": "Collection of UPVC product showcase photos"
    },
    "/photos_data/{photoId}": {
      "schema": "PhotoData",
      "description": "Collection of cloud image data payloads"
    }
  }
}
