rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidCategory(cat) {
      return cat == 'windows' || cat == 'doors' || cat == 'balconies';
    }

    function isValidPhoto(data) {
      return data.keys().hasAll(['imageUrl', 'storagePath', 'category']) &&
        data.keys().hasOnly(['id', 'imageUrl', 'storagePath', 'category', 'title', 'order', 'createdAt', 'updatedAt']) &&
        data.imageUrl is string && data.imageUrl.size() <= 1048576 &&
        data.storagePath is string && data.storagePath.size() <= 1024 &&
        isValidCategory(data.category) &&
        (!('title' in data) || (data.title is string && data.title.size() <= 500)) &&
        (!('order' in data) || data.order is number) &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidPhotoData(data) {
      return data.keys().hasAll(['data']) &&
        data.keys().hasOnly(['id', 'data', 'createdAt']) &&
        data.data is string && data.data.size() <= 1048576 &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    match /photos/{photoId} {
      // All clients worldwide can read and stream UPVC catalog photos
      allow get, list: if true;

      // Allow photo creation, update, delete with validation
      allow create: if isValidId(photoId) && isValidPhoto(incoming());
      allow update: if isValidId(photoId) && isValidPhoto(incoming());
      allow delete: if isValidId(photoId);
    }

    match /photos_data/{photoId} {
      // High-res permanent image data collection
      allow get, list: if true;
      allow create: if isValidId(photoId) && isValidPhotoData(incoming());
      allow update: if isValidId(photoId) && isValidPhotoData(incoming());
      allow delete: if isValidId(photoId);
    }
  }
}
